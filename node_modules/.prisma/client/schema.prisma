generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String?
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  pushToken    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     MobileSession[]
  emails       ProcessedEmail[]

  @@index([email])
}

model MobileSession {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ProcessedEmail {
  id          String   @id @default(cuid())
  messageId   String   @unique
  threadId    String
  sender      String
  subject     String
  body        String
  category    String   @default("ROUTINE")
  summary     String
  important   Boolean  @default(false)
  priority    Int      @default(1)
  confidence  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Escalation tracking (for important emails)
  slackChannelId   String?
  slackMessageTs   String?
  alertSentAt      DateTime?
  repliedAt        DateTime?
  escalatedAt      DateTime?
  // PENDING | REPLIED | ESCALATED | NOT_NEEDED
  escalationStatus String   @default("NOT_NEEDED")

  // Auto-reply tracking (for non-important emails)
  autoReplySent    Boolean  @default(false)
  autoReplyAt      DateTime?

  // Summaries (used by Slack alert + Telegram escalation)
  fromName         String?
  fromEmail        String?
  subjectSummary   String?
  bodySummary      String?

  // Owner — nullable so old rows without a user still survive
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sender])
  @@index([category])
  @@index([important])
  @@index([createdAt])
  @@index([escalationStatus])
  @@index([slackMessageTs])
  @@index([userId])
}
